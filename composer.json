{
    "name": "vortech/laravel-unit-conversions",
    "description": "Fluent, immutable unit conversions for Laravel.",
    "keywords": [
        "vortech",
        "unit-conversions",
        "laravel",
        "units",
        "conversion",
        "metric",
        "imperial",
        "mass",
        "length",
        "capacity",
        "temperature",
        "area",
        "volume",
        "time",
        "speed",
        "acceleration",
        "energy",
        "power",
        "pressure",
        "force",
        "torque",
        "angle",
        "frequency",
        "data-size",
        "flow-rate",
        "density",
        "voltage",
        "current",
        "resistance"
    ],
    "homepage": "https://github.com/Vortech-Group/unit-conversions",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mate Papp",
            "email": "mate@vortech.hu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Vortech\\UnitConversions\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vortech\\UnitConversions\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
