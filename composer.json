{
    "name": "vortech/unit-conversions",
    "description": "Performs unit conversions in Laravel",
    "keywords": [
        "vortech",
        "unit-conversions"
    ],
    "homepage": "https://github.com/vortech/unit-conversions",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mate Papp",
            "email": "mate@vortech.hu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "ext-bcmath": "*",
        "pestphp/pest": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "Vortech\\UnitConversions\\": "src"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-html coverage"

    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
